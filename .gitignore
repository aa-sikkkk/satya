# ============================================================================
# Satya Learning System — .gitignore
# Structure follows github/gitignore Python template + project-specific rules.
# ============================================================================

# --- Byte-compiled / optimized files ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Distribution / packaging ------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Test / coverage / tooling caches ---------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# --- Virtual environments ----------------------------------------------------
.venv/
venv/
ENV/
env/
# Secrets go in .env (never committed); ship the example instead
.env
.env.*
!.env.example

# --- IDE / editor ------------------------------------------------------------
.idea/
.vscode/
.cursor/
.cursorignore
*.swp
*.swo
*.bak

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ============================================================================
# Project-specific: model binaries
# Model weights are downloaded once to satya_data/models/ (see README); the
# repository never ships them.
# ============================================================================

# Model weights & inference binaries
*.gguf
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.ckpt
*.safetensors
*.bin

# Model and vector-store directories (rebuilt by scripts/, populated locally)
satya_data/models/
satya_data/chroma_db/
satya_data/satya_chroma_db/
ai_model/exported_model/

# NOTE: files already tracked inside these dirs (e.g.
# satya_data/models/load_models_offline.py) remain tracked; new binary
# assets dropped here stay ignore-safe by default.

# ============================================================================
# Project-specific: runtime data (regenerated; never commit student data)
# ============================================================================

satya_data/input_normalizer_phrases.json
satya_data/normalization_logs/
satya_data/feedback_db.jsonl
logs/
*.log
*.sqlite
*.db

# ============================================================================
# Project-specific: heavy inputs (textbooks/teacher notes)
# Content sources are distributed out-of-band (see docs/HOW_TO_PROCESS.md)
# ============================================================================

textbooks/grade_*/
notes/grade_*/
